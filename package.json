{
  "name": "jaxel-workspace",
  "version": "0.7.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tauri": "npm run tauri --workspace=@jaxel/editor --",
    "dev": "npm run tauri --workspace=@jaxel/editor -- dev"
  }
}
