{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jaxel",
  "version": "0.3.1",
  "identifier": "de.profiforms.jaxel",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "tsc --noEmit && vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jaxel",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis"],
    "fileAssociations": [
      {
        "ext": ["xml"],
        "mimeType": "application/xml",
        "name": "XML",
        "description": "XML-Dokument"
      },
      {
        "ext": ["json"],
        "mimeType": "application/json",
        "name": "JSON",
        "description": "JSON-Dokument"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./jaxel.desktop"
      },
      "rpm": {
        "desktopTemplate": "./jaxel.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
